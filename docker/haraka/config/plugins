# =============================================================================
# Haraka Plugins for NetSendo Mail Infrastructure (NMI)
# =============================================================================

# SMTP AUTH with the logins NetSendo writes (one per domain with NMI on); only a
# logged-in session may relay, every other outside recipient is refused
netsendo_auth

# The address and the name each message leaves with (dedicated IP when it is
# configured on the server), as NetSendo decided in the login file
netsendo_outbound

# Rate limiting
limit

# No queue plugin: relayed mail goes to Haraka's outbound, which delivers it
# straight to the recipients' mail servers (outbound.ini)
