# =============================================================================
# Haraka Plugins for NetSendo Mail Infrastructure
# =============================================================================
# The MTA only relays mail that NetSendo submits: a session must log in with a
# domain's NMI login (netsendo_auth), everything else is refused at RCPT TO.
# No queue plugin is listed on purpose: relayed mail goes to Haraka's own
# outbound delivery (MX lookup, retries, bounces).

# Rate limiting
limit

# SMTP AUTH against the logins NetSendo issues (plugins/netsendo_auth.js)
netsendo_auth

# Dedicated IPs: the address and HELO name a message leaves with (plugins/netsendo_outbound.js)
netsendo_outbound
