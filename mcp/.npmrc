# The client is released by pushing a `mcp-v<version>` tag, which triggers
# .github/workflows/publish-mcp.yml; the prefix keeps it apart from the
# application's own v<version> tags in this monorepo. `npm version` run here does
# NOT create that tag, nor a commit: this package is not at the repository root,
# so npm only bumps package.json and the lock. Tag by hand (see PUBLISHING.md).
tag-version-prefix=mcp-v
